{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "sortImports": true,
  "overrides": [
    {
      "files": ["**/*.mdx", "**/*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
